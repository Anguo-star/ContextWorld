# Keep generated artifacts out of Git, except explicitly reviewed compact
# summaries that are part of the public technical record.
**/artifacts/
!/artifacts/
artifacts/*
!artifacts/evaluation/
artifacts/evaluation/*
!artifacts/evaluation/dinowm_original_diagnostic_v1/
artifacts/evaluation/dinowm_original_diagnostic_v1/*
!artifacts/evaluation/dinowm_original_diagnostic_v1/summary.json
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
