# Submit four jobs, changing only CW_ENV: pusht, reacher, cube, tworoom.
# work_dir=/opt/huawei/dataset/ag_data/code/ContextWorld
# run_shell_script=scripts/cloud_train.sh
CW_TASK=original
CW_ENV=pusht
CW_FAMILY=prejepa
CW_MODEL_INPUTS=pixels_action
CW_SEEDS=3073
CW_METHOD=native
CW_MAX_EPOCHS=10
CW_BATCH_SIZE=128
CW_ACCUMULATE=1
CW_NUM_WORKERS=2
CW_FRAMESKIP=5
CW_HISTORY_SIZE=3
CW_NUM_PREDS=1
CW_POST_TRAIN_EVAL=1
CW_PRINT_ONLY=0
CW_RESUME=reset
CW_LOGGER=swanlab
CW_SWANLAB_MODE=cloud
CW_SWANLAB_PROJECT=contextworld
# Inject SWANLAB_API_KEY separately. Do not set CW_INIT_CHECKPOINT,
# CW_COMPONENT, CW_DATASET or CW_RUN_NAME when reusing a component job.
# Visual backbone stays pretrained and frozen. Predictor/action encoder
# start from default initialization; no state encoder or state loss is used.
CONTEXTWORLD_BENCHMARK_ROOT=/opt/huawei/dataset/ag_data/data/world_model/ContextWorld-v1
CONTEXTWORLD_DATASET_ROOT=/opt/huawei/dataset/ag_data/data/world_model
CONTEXTWORLD_STABLE_WORLDMODEL_REPO=/opt/huawei/dataset/ag_data/code/stable-worldmodel
CW_CHECKPOINT_ROOT=/opt/huawei/dataset/ag_data/ckpt/dino-wm-pixels-action-v1
CW_OUTPUT=/opt/huawei/dataset/ag_data/ckpt/dino-wm-pixels-action-v1
HF_HUB_CACHE=/opt/huawei/dataset/ag_data/models
# Original-data default names are <CW_ENV>_prejepa_original_s3073;
# CW_TRAINING_TRACK does not rename original-data runs. The separate root
# preserves the historical state-conditioned checkpoints.
# CEM uses 6 evaluation seeds x 50 episodes. The suite also evaluates
# applicable ICL tasks; H3 checkpoints do not cover the H7 Action Delay input.
