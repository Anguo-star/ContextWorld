# ContextWorld DINO-WM/PreJEPA original-environment comparison recipe.
# Copy these KEY=value pairs into the cloud job environment. This is not a
# shell startup script. Submit one job per CW_ENV value.
#
# Cloud platform fields (these two are not process environment variables):
#   work_dir=/absolute/path/to/ContextWorld
#   run_shell_script=scripts/cloud_train.sh

CW_TASK=original
CW_ENV=tworoom
CW_FAMILY=prejepa
CW_SEEDS=3072,3073,3074

# Baseline-comparable training geometry. With eight GPUs this gives an
# effective global batch of 128 * 8 * 1 = 1024.
CW_MAX_EPOCHS=10
CW_BATCH_SIZE=128
CW_NUM_WORKERS=16
CW_TRAIN_SPLIT=0.9
CW_FRAMESKIP=5
CW_HISTORY_SIZE=3
CW_NUM_PREDS=1
CW_DEVICES=auto
CW_ACCELERATOR=gpu
CW_STRATEGY=ddp
CW_PRECISION=16-mixed
CW_ACCUMULATE=1
CW_GRADIENT_CLIP_VAL=1.0
CW_LEARNING_RATE=0.0005
CW_WEIGHT_DECAY=0

# Fresh runs are isolated by environment, family and seed. Keep logger=none
# for a dependency-free first run. A Stable-WorldModel checkout whose
# PreJEPA trainer uses build_training_logger supports both wandb and SwanLab.
CW_RESUME=never
CW_LOGGER=none
# For SwanLab, set CW_LOGGER=swanlab and inject SWANLAB_API_KEY as a secret.
# Do not enable it with the public revision pinned by ContextWorld; use a
# separately identified compatible checkout whose PreJEPA trainer calls
# build_training_logger.
# CW_SWANLAB_PROJECT=contextworld
# CW_SWANLAB_WORKSPACE=your-workspace
CW_POST_TRAIN_EVAL=0

# Replace every placeholder with an absolute cloud mount path.
CONTEXTWORLD_DATASET_ROOT=/absolute/path/data/world_model
CW_CHECKPOINT_ROOT=/absolute/path/checkpoints/dino-wm
CW_OUTPUT=/absolute/path/training-logs/dino-wm
CONTEXTWORLD_STABLE_WORLDMODEL_REPO=/absolute/path/stable-worldmodel
HF_HUB_CACHE=/absolute/path/huggingface-cache

# Set to 1 for a no-write command/config validation job; set to 0 to train.
CW_PRINT_ONLY=0
